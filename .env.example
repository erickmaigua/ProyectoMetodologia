# Configuración de Variables de Entorno
# Copiar a .env y modificar con valores reales

# MongoDB Atlas (NO SUBIR AL REPOSITORIO CON CREDENCIALES REALES)
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_CONTRASEÑA@cluster0.gywuszl.mongodb.net/zapateria_db?retryWrites=true&w=majority&appName=Cluster0

# Servidor
SERVER_PORT=8080

# Credenciales de Administrador (CAMBIAR EN PRODUCCIÓN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_CONTRASEÑA_SEGURA
ADMIN_EMAIL=admin@zapateria.com
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema
ADMIN_TELEFONO=0999999999

# NOTA: Este proyecto ya tiene configurada la URI de Atlas directamente en application.properties
# Si prefieres usar variables de entorno, descomenta en application.properties:
# spring.data.mongodb.uri=${MONGODB_URI}

